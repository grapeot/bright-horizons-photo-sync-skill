# 从浏览器 DevTools 中复制成功 /remote/v1/events 请求的完整 Cookie header。
BH_SESSION_COOKIE="paste-cookie-header-here"

# 从同一请求复制。不要依赖源码默认值。
BH_TADPOLES_UID="replace-with-account-uid"
BH_DEPENDENT_ID="replace-with-child-dependent-id"

# 可选：同步日期边界和 Photos EXIF 使用的 IANA 时区。
BH_TIMEZONE="America/Los_Angeles"

# 可选覆盖；未设置时使用项目根目录下被 Git ignore 的 data/。
# BH_DATA_DIR="/absolute/custom/path"
